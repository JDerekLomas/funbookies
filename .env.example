# LilBookies Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# Image Generation APIs
# ============================================

# fal.ai API key (recommended for image generation - 80% cheaper for wan2.6)
# Get your key at: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here

# MuleRouter API key (fallback provider)
# Get your key at: https://mulerouter.ai
MULEROUTER_API_KEY=your_mulerouter_api_key_here

# ============================================
# Audio Generation APIs
# ============================================

# ElevenLabs API key (for phoneme sounds with IPA tags)
# Get your key at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI API key (for TTS and GPT-4)
# Get your key at: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Storage & Database
# ============================================

# Vercel Blob storage token
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ============================================
# Other Services
# ============================================

# Anthropic API key (for Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub token (for deployments)
GITHUB_TOKEN=your_github_token_here
