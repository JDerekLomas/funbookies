{
  "version": 2,
  "functions": {
    "api/generate-image.js": {
      "maxDuration": 60
    },
    "api/upload-image.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/check-status", "dest": "/api/check-status.js" },
    { "src": "/api/generate-image", "dest": "/api/generate-image.js" },
    { "src": "/api/generate-story", "dest": "/api/generate-story.js" },
    { "src": "/api/evaluations", "dest": "/api/evaluations.js" },
    { "src": "/api/feedback", "dest": "/api/feedback.js" },
    { "src": "/api/validate-text", "dest": "/api/validate-text.js" },
    { "src": "/api/update-book-github", "dest": "/api/update-book-github.js" },
    { "src": "/api/upload-image", "dest": "/api/upload-image.js" },
    { "src": "/api/save-book", "dest": "/api/save-book-supabase.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
